# Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here
ALLOWED_USER_ID=123456789

# Пути
WHISPER_MODEL_PATH=./models/whisper/ggml-large-v3.bin
NOTES_DIR=./notes
TEMP_DIR=./data

# Whisper настройки
WHISPER_LANGUAGE=ru
WHISPER_THREADS=4
WHISPER_EXECUTABLE=whisper-cli

# Qwen настройки
QWEN_MODEL=qwen2.5:3b
QWEN_TEMPERATURE=0.3
QWEN_TIMEOUT=30
TAKOPI_EXECUTABLE=/opt/homebrew/bin/ollama

# Ограничения
MAX_VOICE_DURATION=180
MAX_FILE_SIZE_MB=10

# Логирование
LOG_LEVEL=INFO

# Очистка временных файлов (часы)
CLEANUP_TEMP_FILES_HOURS=24
